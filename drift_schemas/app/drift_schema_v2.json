  "fixed_sql": [
    {
      "name": "profiles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profiles\" (\"id\" TEXT NOT NULL, \"display_name\" TEXT NOT NULL DEFAULT '', \"currency_code\" TEXT NOT NULL DEFAULT 'TND', \"freelancer_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"freelancer_enabled\" IN (0, 1)), \"updated_at\" TEXT NOT NULL, \"change_seq\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"user_id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"version\" INTEGER NOT NULL DEFAULT 0, \"change_seq\" INTEGER NOT NULL DEFAULT 0, \"workspace\" TEXT NOT NULL DEFAULT 'personal', \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"icon_key\" TEXT NOT NULL DEFAULT 'tag', \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
